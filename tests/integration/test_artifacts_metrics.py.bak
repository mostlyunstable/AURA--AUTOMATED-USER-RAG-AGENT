import os
import pytest
from uuid import uuid4
from unittest.mock import AsyncMock

from core.domain.execution.entities import ExecutionCommand, ExecutionEnvironment
from core.infrastructure.execution.artifact_collector import ArtifactCollector
from core.domain.execution.enums import ArtifactType
from core.infrastructure.metrics.execution import aura_artifacts_created_total, aura_artifacts_rejected_total

@pytest.mark.asyncio
async def test_artifact_collector_valid_path(tmp_path):
    # Setup
    worktree = tmp_path / "worktree"
    worktree.mkdir()
    
    file_path = worktree / "test.txt"
    file_path.write_text("hello artifact")
    
    env = ExecutionEnvironment(
        id=uuid4(),
        mission_id=uuid4(),
        task_id=uuid4(),
        execution_id=uuid4(),
        worktree_path=str(worktree)
    )
    
    collector = ArtifactCollector(worktree_root=str(tmp_path))
    
    # Collect
    before_created = aura_artifacts_created_total._value.get()
    
    art = collector.collect(env, "test.txt", ArtifactType.FILE)
    
    assert art is not None
    assert art.size == 14
    assert art.path == "test.txt"
    assert aura_artifacts_created_total._value.get() == before_created + 1

@pytest.mark.asyncio
async def test_artifact_collector_path_traversal(tmp_path):
    worktree = tmp_path / "worktree"
    worktree.mkdir()
    
    secret = tmp_path / "secret.txt"
    secret.write_text("password")
    
    env = ExecutionEnvironment(
        id=uuid4(),
        mission_id=uuid4(),
        task_id=uuid4(),
        execution_id=uuid4(),
        worktree_path=str(worktree)
    )
    
    collector = ArtifactCollector(worktree_root=str(tmp_path))
    
    before_rejected = aura_artifacts_rejected_total._value.get()
    
    art = collector.collect(env, "../secret.txt", ArtifactType.FILE)
    
    assert art is None
    assert aura_artifacts_rejected_total._value.get() == before_rejected + 1

@pytest.mark.asyncio
async def test_artifact_collector_symlink_escape(tmp_path):
    worktree = tmp_path / "worktree"
    worktree.mkdir()
    
    secret = tmp_path / "secret.txt"
    secret.write_text("password")
    
    symlink_path = worktree / "link.txt"
    os.symlink(str(secret), str(symlink_path))
    
    env = ExecutionEnvironment(
        id=uuid4(),
        mission_id=uuid4(),
        task_id=uuid4(),
        execution_id=uuid4(),
        worktree_path=str(worktree)
    )
    
    collector = ArtifactCollector(worktree_root=str(tmp_path))
    
    art = collector.collect(env, "link.txt", ArtifactType.FILE)
    
    assert art is None

@pytest.mark.asyncio
async def test_artifact_size_limit(tmp_path):
    worktree = tmp_path / "worktree"
    worktree.mkdir()
    
    file_path = worktree / "big.txt"
    file_path.write_text("A" * 105)
    
    env = ExecutionEnvironment(
        id=uuid4(),
        mission_id=uuid4(),
        task_id=uuid4(),
        execution_id=uuid4(),
        worktree_path=str(worktree)
    )
    
    collector = ArtifactCollector(worktree_root=str(tmp_path), max_bytes=100)
    
    art = collector.collect(env, "big.txt", ArtifactType.FILE)
    
    assert art is None
